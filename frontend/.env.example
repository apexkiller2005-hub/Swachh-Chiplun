# ---------------------------------------------------------------- frontend/.env.example
# Copy to frontend/.env for local development. On Vercel, set the same values in
# Project -> Settings -> Environment Variables. Only VITE_ values belong here:
# they are visible in the browser, so never put a secret key in this file.

# Development only (e.g. http://localhost:8001). Production builds ignore this
# value and always call their own origin, /api/*, which vercel.json forwards to
# Render — no CORS and first-party Clerk cookies.
VITE_BACKEND_URL=

# Dev-server proxy target (only used by `yarn dev`, ignored in production builds)
VITE_BACKEND_PROXY=http://localhost:8001

# Optional. A pk_test_ key lets the app start Clerk without waiting for the
# backend. LIVE keys (pk_live_) are ignored here — they need the backend-provided
# proxy URL, so leave this empty for production.
VITE_CLERK_PUBLISHABLE_KEY=
