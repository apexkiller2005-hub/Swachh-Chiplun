# ---------------------------------------------------------------- backend/.env.example
# Copy to backend/.env for local development. On Render, put these in
# Dashboard -> your service -> Environment instead (never commit .env).

# Database — local MongoDB or a free MongoDB Atlas cluster (Network Access 0.0.0.0/0)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="swachh_chiplun"

# Browser origin(s) allowed to call the API directly, comma separated.
# Example: https://swachh-chiplun.vercel.app
# With the Vercel /api rewrite (recommended) requests are same-origin, so this is
# only a safety net. Do not wrap values in quotes in the Render dashboard.
CORS_ORIGINS="http://localhost:3000"
# Optional: allow Vercel preview deployments, e.g. https://.*\.vercel\.app
# CORS_ORIGIN_REGEX=

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# gemini-3.5-flash has only ~20 free requests/day. gemini-3.1-flash-lite is
# multimodal and has a much larger free quota — recommended for the free tier.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Clerk sign-in — https://dashboard.clerk.com -> your app -> API Keys
# Both keys must belong to the SAME instance (both test or both live).
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Only for LIVE keys (pk_live_/sk_live_): the public URL of the Clerk proxy.
# Must match Configure -> Domains -> Proxy in the Clerk dashboard, and must be on
# the FRONTEND domain (so Clerk's session cookie stays first-party).
# Example: https://swachh-chiplun.vercel.app/api/__clerk
CLERK_PROXY_URL=

# The ONE admin: must be the verified primary email of a Clerk account
ADMIN_EMAIL=apexkiller2005@gmail.com
# Optional second lock for the admin panel
ADMIN_PASSCODE=apex@2005
